# REPO-HEAL configuration. Copy to .env and adjust.

# Where cloned/snapshotted repositories are stored.
REPOHEAL_WORKDIR=./.repoheal

# Logging
REPOHEAL_LOG_LEVEL=INFO
REPOHEAL_LOG_FORMAT=json    # json | console

# Ingestion
REPOHEAL_GIT_TIMEOUT_SECONDS=300
REPOHEAL_MAX_FILE_SIZE_BYTES=2097152   # 2 MiB; larger files are skipped at parse time

# Sandbox (subprocess for now; docker planned)
REPOHEAL_SANDBOX_BACKEND=subprocess
REPOHEAL_SANDBOX_DEFAULT_TIMEOUT=60

# Graph backend
REPOHEAL_GRAPH_BACKEND=networkx
